{
  "name": "anybot-connector",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A small, explicit interoperability layer for bot providers",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harzva/anybot-connector.git"
  },
  "bin": {
    "anybot-connector": "src/cli/index.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./contract": "./src/contract.mjs"
  },
  "files": [
    "src/",
    "examples/",
    "spec/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=15000 test/*/*.test.mjs",
    "start": "node src/cli/index.mjs",
    "check": "node tools/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
